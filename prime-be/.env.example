# ─────────────────────────────────────────────────────────────
# prime-be 환경변수 (로컬: .env, 서버: GitHub Secrets로 주입)
# ─────────────────────────────────────────────────────────────

# === 실행 환경 ===
NODE_ENV=development
PORT=3000

# === 메인 MySQL DB (지역 폴리곤·실거래 데이터) ===
DB_HOSTNAME=localhost
DB_PORT=3306
DB_USER=prime
DB_PASSWORD=prime_local_pass
DB_DATABASE=prime

# === 공용 MySQL (user, social_account, admin 등 인증/공통 테이블) ===
COMMON_DB_HOST=localhost
COMMON_DB_PORT=3306
COMMON_DB_USER=prime
COMMON_DB_PASSWORD=prime_local_pass
COMMON_DB_NAME=prime_common

# === JWT ===
JWT_TOKEN_SECRET_KEY=replace_with_long_random_string_min_32_chars

# === 프론트엔드 URL (로그인 콜백 리다이렉트 등) ===
FRONTEND_URL=http://localhost:3001
PRIME_LOGIN_SUCCESS_REDIRECT_URI=http://localhost:3001/?status=success
PRIME_SOCIAL_LINK_REDIRECT_URI=http://localhost:3001/user-update?social=linked

# === V-World (행정구역·필지 좌표 API) ===
VWORLD_API_KEY=
VWORLD_DOMAIN=localhost

# === 네이버 검색 API (주소 → 좌표 보조) ===
NAVER_API_URL=https://openapi.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# === OAuth: Naver Login ===
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
NAVER_LOGIN_REDIRECT_URI=http://localhost:3000/oauth/naver/callback

# === OAuth: Kakao Login ===
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao/callback

# === OAuth: Google Login ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# === OAuth: Apple Login ===
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:3000/oauth/apple/callback
